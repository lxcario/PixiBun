# PixiBun - Environment Variables Example
# Do not commit real values to this file.

# GitHub tokens for issue/diagnostic integration
GITHUB_TOKEN="your_github_token_here"
GITHUB_PAT="your_github_pat_here"

# Diagnostics relay configuration
DIAGNOSTICS_RELAY_URL="https://relay.example.com/diagnostics"

# Vercel OIDC settings for secure deployment
VERCEL_OIDC_TOKEN="example_vercel_oidc_token"
