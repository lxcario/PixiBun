# Optional server-owned HTTPS diagnostics target; empty keeps forwarding disabled.
DIAGNOSTICS_RELAY_URL=
# Optional build-time service-worker identity override. Normally derived from the
# deployment commit or Git HEAD. Git-less production builds must set a unique
# release tag; never reuse one for different application builds.
# SW_CACHE_VERSION=v1.14.1-release-YYYYMMDD-build-N
# Optional local compiled-production test port (default 3100).
# PIXIBUN_PRODUCTION_PORT=3100
