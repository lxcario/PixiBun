{
  "name": "pixibun",
  "version": "1.14.1",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build && node scripts/writePrecacheManifest.mjs",
    "start": "next start",
    "lint": "eslint src tests scripts *.config.mjs *.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:performance": "node scripts/runPerformanceChecks.mjs",
    "test:e2e": "playwright test",
    "test:e2e:production": "playwright test --config playwright.production.config.ts",
    "nibbli:test": "node scripts/nibbli/run.mjs",
    "nibbli:memory": "node scripts/nibbli/experience.mjs",
    "nibbli:artist": "node scripts/nibbli/runArtist.mjs",
    "nibbli:hands": "node scripts/nibbli/runArtist.mjs --hands",
    "verify:docs": "node scripts/verifyDocIntegrity.mjs",
    "docs:inventory": "node scripts/generateDocInventory.mjs",
    "ledger:md": "node scripts/generateLoopLedger.mjs",
    "themes:css": "node scripts/generateThemeCss.mjs",
    "evidence:publish": "node scripts/publishEvidence.mjs",
    "evidence:index": "node scripts/indexVerificationEvidence.mjs",
    "gate": "node scripts/runQualityGate.mjs",
    "gate:full": "node scripts/runQualityGate.mjs --with-build",
    "prepare": "node scripts/installGitHooks.mjs"
  },
  "engines": {
    "node": ">=22.0.0 <23.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "clsx": "^2.1.1",
    "dexie": "^4.0.11",
    "immer": "^10.1.1",
    "motion": "^12.4.7",
    "next": "16.3.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.2",
    "web-vitals": "^6.2.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@actions/expressions": "0.3.61",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.20.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.0.9",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "^9.20.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.11.0",
    "happy-dom": "^20.12.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
