{"type":"before","callId":"call@12","startTime":3110.831,"class":"Frame","method":"evaluateExpression","params":{"expression":"() => {\n    const canvas = document.createElement('canvas');\n    canvas.width = 64;\n    canvas.height = 32;\n    const ctx = canvas.getContext('2d');\n    for (let i = 0; i < 2; i++) {\n      ctx.fillStyle = '#ffffff';\n      ctx.fillRect(i * 32 + 8 + i, 8, 8, 8);\n      ctx.fillStyle = 'rgba(120,120,120,0.2)';\n      ctx.fillRect(i * 32 + 2, 2, 1, 1);\n      ctx.fillRect(i * 32 + 6, 6, 1, 1);\n    }\n    ctx.fillStyle = '#ef497e';\n    ctx.fillRect(32 + 12, 11, 1, 1);\n    return canvas.toDataURL('image/png').split(',')[1];\n  }","isFunction":true,"arg":{"value":{"v":"undefined"},"handles":[]}},"stepId":"pw:api@36","pageId":"page@65d0759ce6193517a9fd576a190ee697","beforeSnapshot":"before@call@12"}
