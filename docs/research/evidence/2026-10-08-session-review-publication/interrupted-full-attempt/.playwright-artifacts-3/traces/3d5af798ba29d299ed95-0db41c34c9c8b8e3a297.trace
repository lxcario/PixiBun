{"type":"before","callId":"call@12","startTime":350104.111,"class":"Frame","method":"evaluateExpression","params":{"expression":"() => {\n    const canvas = document.createElement('canvas');\n    canvas.width = 64;\n    canvas.height = 32;\n    const ctx = canvas.getContext('2d');\n    for (let i = 0; i < 2; i++) {\n      ctx.fillStyle = '#ffffff';\n      ctx.fillRect(i * 32 + 8 + i, 8, 8, 8);\n      ctx.fillStyle = 'rgba(120,120,120,0.2)';\n      ctx.fillRect(i * 32 + 2, 2, 1, 1);\n      ctx.fillRect(i * 32 + 6, 6, 1, 1);\n    }\n    ctx.fillStyle = '#ef497e';\n    ctx.fillRect(32 + 12, 11, 1, 1);\n    return canvas.toDataURL('image/png').split(',')[1];\n  }","isFunction":true,"arg":{"value":{"v":"undefined"},"handles":[]}},"stepId":"pw:api@36","pageId":"page@751fb5202139c040ce76b0e1d1047278","beforeSnapshot":"before@call@12"}
