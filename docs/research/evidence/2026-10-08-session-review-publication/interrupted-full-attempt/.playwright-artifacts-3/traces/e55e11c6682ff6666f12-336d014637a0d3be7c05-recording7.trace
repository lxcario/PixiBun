{"type":"before","callId":"call@719","startTime":430952.497,"class":"Frame","method":"evaluateExpression","params":{"expression":"() => {\n    const png = (alpha = 1) => {\n      const canvas = document.createElement('canvas');\n      canvas.width = 32;\n      canvas.height = 32;\n      const ctx = canvas.getContext('2d');\n      ctx.fillStyle = `rgba(255,0,0,${alpha})`;\n      ctx.fillRect(2, 2, 3, 3);\n      return canvas.toDataURL('image/png').split(',')[1];\n    };\n    const body = i => ({\n      id: `body-${i}`,\n      name: 'Body',\n      visible: true,\n      locked: false,\n      opacity: 1,\n      blendMode: 'source-over',\n      pngBase64: png()\n    });\n    const light = {\n      id: 'light-1',\n      name: 'Lighting',\n      visible: false,\n      locked: false,\n      opacity: 1,\n      blendMode: 'source-over',\n      pngBase64: png(0.2)\n    };\n    return {\n      format: 'pixibun-project',\n      version: 3,\n      name: 'Identity fixture',\n      width: 32,\n      height: 32,\n      fps: 8,\n      loopMode: 'repeat',\n      onionSkin: {\n        enabled: false,\n        prevFrames: 1,\n        nextFrames: 1,\n        prevColor: '#c792df',\n        nextColor: '#dcabdf',\n        opacity: 0.45\n      },\n      palettes: [{\n        id: 'roles',\n        name: 'Roles',\n        colors: ['#ff0000', '#ff0000'],\n        semantics: {\n          entries: [{\n            id: 'cloth',\n            role: 'cloth'\n          }, {\n            id: 'fire',\n            role: 'fire'\n          }],\n          bindings: [{\n            id: 'fire-region',\n            frameId: 'frame-0',\n            entryId: 'fire',\n            x: 0,\n            y: 0,\n            w: 32,\n            h: 32\n          }]\n        }\n      }],\n      currentPaletteId: 'roles',\n      customRamps: [],\n      clips: [{\n        id: 'attack',\n        name: 'Attack',\n        startFrame: 1,\n        endFrame: 2,\n        loopMode: 'forward'\n      }],\n      frames: [0, 1, 2, 3].map