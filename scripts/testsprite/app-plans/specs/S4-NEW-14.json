    {
      "click": "2x",
      "role": "radio",
      "within": "Live Preview Window"
    },
    {
      "click": "4x",
      "role": "radio",
      "within": "Live Preview Window"
    },
    {
      "checked": "4x",
      "role": "radio",
      "within": "Live Preview Window",
      "why": "The chosen scale is selected."
