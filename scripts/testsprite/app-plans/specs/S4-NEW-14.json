    {
      "click": "Backdrop: obsidian",
      "role": "radio",
      "within": "Live Preview Window"
    },
    {
      "checked": "Backdrop: obsidian",
      "role": "radio",
      "within": "Live Preview Window"
    },
    {
      "click": "Minimize Preview Window",
      "within": "Live Preview Window"
    },
    {
      "visible": "Expand Preview Window",
      "why": "The preview folds."
    },
    {
      "click": "Expand Preview Window"
    },
    {
      "visible": "Minimize Preview Window",
      "within": "Live Preview Window",
      "why": "The preview unfolds."
    },
    {
      "readout": {
        "digest": "=A",
        "frames": "1",
        "layers": "1"
      },
      "why": "The preview never edits the drawing."
    },
    {
      "disabled": "Undo last action",
      "why": "Preview controls add no history."
    }
