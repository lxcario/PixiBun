  "key": "S4-NEW-10",
  "title": "S4-NEW-10 — A typo stays in the paint pot.",
  "goal": "A valid hex commits with Enter; an invalid one is never committed; the first Escape reverts the pending typo in the field and the second closes Colors, leaving #FF0000 as the primary and the drawing unchanged.",
  "steps": [
    {
      "open": "/studio?template=bun"
    },
    {
      "skip": true
    },
    {
      "record": "A"
    },
    {
      "click": "/^Primary color/"
    },
    {
      "fill": "Primary hex value",
      "value": "#FF0000"
    },
    {
      "key": "Enter"
    },
    {
      "visible": "/^Primary color #FF0000/i",
      "why": "A valid hex commits."
    },
    {
      "fill": "Primary hex value",
      "value": "#GGGGGG"
    },
    {
      "key": "Enter"
    },
    {
      "visible": "/^Primary color #FF0000/i",
      "why": "The typo is not committed."
    },
    {
      "key": "Escape"
    },
    {
      "field": "Primary hex value",
      "equals": "#FF0000",
      "why": "The first Escape reverts the pending typo."
    },
    {
      "key": "Escape"
    },
    {
      "absent": "Close color access",
      "why": "The second Escape closes Colors."
    },
    {
      "visible": "/^Primary color #FF0000/i"
    },
    {
      "readout": {
        "digest": "=A"
      },
      "why": "Editing colors changed no artwork."
    }
  ]
}